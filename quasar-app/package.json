{
  "name": "personal",
  "version": "0.0.1",
  "description": "A Quasar Project",
  "productName": "Aggregation Space",
  "author": "",
  "main": "src-electron/electron-main.js",
  "type": "module",
  "private": true,
  "scripts": {
    "lint": "eslint -c ./eslint.config.js \"./src*/**/*.{js,cjs,mjs,vue}\"",
    "format": "prettier --write \"**/*.{js,vue,css,scss,html,md,json}\" --ignore-path .gitignore",
    "test": "echo \"No test specified\" && exit 0",
    "dev": "quasar dev",
    "dev:spa": "quasar dev",
    "build": "quasar build -m electron",
    "build:native": "node scripts/build-native.js",
    "build:electron": "quasar build",
    "build:electron:win": "npm run build:native && quasar build && electron-builder --win",
    "build:electron:mac": "quasar build && electron-builder --mac",
    "build:electron:linux": "quasar build && electron-builder --linux",
    "postinstall": "quasar prepare"
  },
  "dependencies": {
    "@capacitor/android": "^8.3.1",
    "@capacitor/cli": "^8.3.1",
    "@capacitor/core": "^8.3.1",
    "@capacitor/ios": "^8.3.1",
    "@quasar/extras": "^1.16.4",
    "axios": "^1.15.2",
    "d3": "^7.9.0",
    "d3-force-3d": "^3.0.6",
    "electron-store": "^11.0.2",
    "flatbuffers": "^24.3.25",
    "highlight.js": "^11.11.1",
    "hls.js": "^1.6.16",
    "marked": "^18.0.3",
    "pinia": "^3.0.1",
    "quasar": "^2.16.0",
    "three": "^0.184.0",
    "vue": "^3.5.22",
    "vue-i18n": "^11.3.0",
    "vue-router": "^5.0.3",
    "win32-api": "^26.1.2"
  },
  "devDependencies": {
    "@electron/packager": "^19.1.1",
    "@electron/rebuild": "^4.0.4",
    "@eslint/js": "^9.39.4",
    "@intlify/unplugin-vue-i18n": "^11.0.0",
    "@quasar/app-vite": "^2.5.1",
    "@vue/eslint-config-prettier": "^10.2.0",
    "autoprefixer": "^10.4.27",
    "electron": "^41.5.0",
    "electron-builder": "^26.8.1",
    "electron-packager": "^17.1.2",
    "eslint": "^9.39.4",
    "eslint-plugin-vue": "^10.8.0",
    "globals": "^17.4.0",
    "postcss": "^8.5.8",
    "prettier": "^3.8.1",
    "vite-plugin-checker": "^0.12.0",
    "vue-eslint-parser": "^10.4.0"
  },
  "engines": {
    "node": "^28 || ^26 || ^24 || ^22.12",
    "npm": ">= 6.13.4",
    "yarn": ">= 1.21.1",
    "pnpm": ">= 10.0.0"
  }
}
