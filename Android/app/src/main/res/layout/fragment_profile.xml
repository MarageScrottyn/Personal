<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/flora_base"
    android:fitsSystemWindows="true">

    <LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/flora_leaf">

    <!-- 用户信息头部 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/flora_profile_header_bg"
            android:paddingTop="32dp"
            android:paddingBottom="80dp"
            android:paddingHorizontal="16dp"
            android:gravity="center_vertical">

            <!-- 头像容器 -->
            <FrameLayout
                android:layout_width="64dp"
                android:layout_height="64dp">

                <ImageView
                    android:id="@+id/iv_avatar"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:src="@drawable/ic_user"
                    android:background="@drawable/flora_avatar_bg"
                    android:padding="12dp"
                    android:contentDescription="用户头像" />
            </FrameLayout>

            <!-- 用户信息 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="16dp">

                <TextView
                    android:id="@+id/tv_username"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="用户"
                    android:textSize="20sp"
                    android:textColor="@color/white"
                    android:fontFamily="sans-serif-medium" />

                <TextView
                    android:id="@+id/tv_email"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="user@example.com"
                    android:textSize="14sp"
                    android:textColor="@color/flora_base"
                    android:alpha="0.9"
                    android:layout_marginTop="4dp" />
            </LinearLayout>
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginTop="-40dp"

            style="@style/TopRoundedCardStyle"
            app:cardBackgroundColor="@color/flora_base_light">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    >

                        <!-- 同步媒体 -->
                        <LinearLayout
                            android:id="@+id/ll_sync_media"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:padding="16dp"
                            android:background="?android:attr/selectableItemBackground">

                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:src="@drawable/ic_sync"
                                android:tint="@color/flora_leaf" />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/sync_media"
                                android:textSize="16sp"
                                android:textColor="@color/flora_stem"
                                android:layout_marginStart="16dp" />

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:src="@drawable/ic_chevron_right"
                                android:tint="@color/flora_stem_light" />
                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginHorizontal="16dp"
                            android:background="@color/flora_base_dark" />

                        <!-- 修改密码 -->
                        <LinearLayout
                            android:id="@+id/ll_change_password"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:padding="16dp"
                            android:background="?android:attr/selectableItemBackground">

                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:src="@drawable/ic_password"
                                android:tint="@color/flora_leaf" />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/change_password"
                                android:textSize="16sp"
                                android:textColor="@color/flora_stem"
                                android:layout_marginStart="16dp" />

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:src="@drawable/ic_chevron_right"
                                android:tint="@color/flora_stem_light" />
                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginHorizontal="16dp"
                            android:background="@color/flora_base_dark" />

                        <!-- 主题模式 -->
                        <LinearLayout
                            android:id="@+id/ll_theme_mode"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:padding="16dp"
                            android:background="?android:attr/selectableItemBackground">

                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:src="@drawable/ic_cloud"
                                android:tint="@color/flora_leaf" />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/theme_mode"
                                android:textSize="16sp"
                                android:textColor="@color/flora_stem"
                                android:layout_marginStart="16dp" />

                            <TextView
                                android:id="@+id/tv_theme_value"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/theme_follow_system"
                                android:textSize="14sp"
                                android:textColor="@color/flora_leaf" />

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:src="@drawable/ic_chevron_right"
                                android:tint="@color/flora_stem_light"
                                android:layout_marginStart="8dp" />
                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginHorizontal="16dp"
                            android:background="@color/flora_base_dark" />

                        <!-- 设置 -->
                        <LinearLayout
                            android:id="@+id/ll_settings"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:padding="16dp"
                            android:background="?android:attr/selectableItemBackground">

                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:src="@drawable/ic_settings"
                                android:tint="@color/flora_leaf" />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/settings"
                                android:textSize="16sp"
                                android:textColor="@color/flora_stem"
                                android:layout_marginStart="16dp" />

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:src="@drawable/ic_chevron_right"
                                android:tint="@color/flora_stem_light" />
                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginHorizontal="16dp"
                            android:background="@color/flora_base_dark" />

                        <!-- 管理 -->
                        <LinearLayout
                            android:id="@+id/ll_admin"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:padding="16dp"
                            android:background="?android:attr/selectableItemBackground">

                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:src="@drawable/ic_admin"
                                android:tint="@color/flora_leaf" />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="管理"
                                android:textSize="16sp"
                                android:textColor="@color/flora_stem"
                                android:layout_marginStart="16dp" />

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:src="@drawable/ic_chevron_right"
                                android:tint="@color/flora_stem_light" />
                        </LinearLayout>

                        <!-- 用户权限信息 -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp">
                            
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="账户权限"
                                android:textSize="16sp"
                                android:textColor="@color/flora_stem"
                                android:fontFamily="sans-serif-medium" />
                                
                            <TextView
                                android:id="@+id/tv_user_type"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="普通用户"
                                android:textSize="14sp"
                                android:textColor="@color/flora_leaf"
                                android:layout_marginTop="8dp" />
                                
                            <TextView
                                android:id="@+id/tv_permissions"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="权限: 无"
                                android:textSize="14sp"
                                android:textColor="@color/flora_stem_light"
                                android:layout_marginTop="4dp" />
                                
                            <TextView
                                android:id="@+id/tv_access_comic_categories"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="可访问漫画分类: 全部"
                                android:textSize="14sp"
                                android:textColor="@color/flora_stem_light"
                                android:layout_marginTop="4dp" />
                                
                            <TextView
                                android:id="@+id/tv_access_video_categories"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="可访问视频分类: 全部"
                                android:textSize="14sp"
                                android:textColor="@color/flora_stem_light"
                                android:layout_marginTop="4dp" />
                        </LinearLayout>

                        <!-- 退出登录按钮 -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_logout"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/logout"
                            android:textColor="@color/flora_bloom_dark"
                            android:textSize="16sp"
                            android:paddingVertical="14dp"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            app:strokeColor="@color/flora_bloom_dark"
                            android:layout_marginTop="24dp"
                            android:layout_marginHorizontal="16dp"
                            android:layout_marginBottom="24dp" />

                </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>