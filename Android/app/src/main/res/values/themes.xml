<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Base.Theme.MyApplication" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/flora_leaf</item>
        <item name="colorPrimaryDark">@color/flora_leaf_dark</item>
        <item name="colorAccent">@color/flora_bloom</item>
        <item name="android:windowBackground">@color/flora_base</item>
        <item name="colorSurface">@color/flora_base_light</item>
        <item name="colorOnSurface">@color/flora_stem</item>
        <item name="colorSurfaceVariant">@color/flora_base_dark</item>
        <item name="android:windowDrawsSystemBarBackgrounds" tools:targetApi="l">true</item>
        <item name="android:statusBarColor" tools:targetApi="l">@android:color/transparent</item>
        <item name="android:navigationBarColor" tools:targetApi="l">@color/flora_base</item>
        <item name="android:windowTranslucentStatus" tools:targetApi="l">false</item>
        <item name="android:windowLayoutInDisplayCutoutMode" tools:targetApi="p">shortEdges</item>
        
        <item name="materialButtonStyle">@style/Widget.Material3.Button</item>
        <item name="textInputStyle">@style/Widget.Material3.TextInputLayout.OutlinedBox</item>
        <item name="materialCardViewStyle">@style/Widget.Material3.CardView.Outlined</item>
    </style>

    <style name="Theme.MyApplication" parent="Base.Theme.MyApplication" />
    
    <style name="FloraButton" parent="Widget.Material3.Button.ElevatedButton">
        <item name="android:background">@drawable/flora_button_bg</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">16sp</item>
        <item name="android:paddingHorizontal">24dp</item>
        <item name="android:paddingVertical">14dp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    
    <style name="FloraCard">
        <item name="android:background">@drawable/flora_card_bg</item>
        <item name="android:elevation">4dp</item>
    </style>
    
    <style name="FloraEditText">
        <item name="android:background">@drawable/flora_edittext_bg</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">16sp</item>
        <item name="android:paddingHorizontal">16dp</item>
        <item name="android:paddingVertical">14dp</item>
    </style>
    
    <style name="FloraTextTitle">
        <item name="android:textColor">@color/flora_stem</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    
    <style name="FloraTextBody">
        <item name="android:textColor">@color/flora_stem</item>
        <item name="android:textSize">16sp</item>
    </style>
    
    <style name="FloraDialog" parent="Theme.Material3.DayNight.Dialog.Alert">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowMinWidthMajor">90%</item>
        <item name="android:windowMinWidthMinor">90%</item>
        <item name="android:windowIsFloating">true</item>
    </style>
    
    <style name="FloraBreadcrumbHome">
        <item name="android:textColor">@color/flora_leaf</item>
        <item name="android:textSize">16sp</item>
        <item name="android:paddingHorizontal">12dp</item>
        <item name="android:paddingVertical">10dp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>
    
    <style name="FloraBreadcrumbItem">
        <item name="android:textColor">@color/flora_stem</item>
        <item name="android:textSize">16sp</item>
        <item name="android:paddingHorizontal">12dp</item>
        <item name="android:paddingVertical">10dp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>
    
    <style name="FloraCategorySelected">
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">14sp</item>
        <item name="android:paddingHorizontal">16dp</item>
        <item name="android:paddingVertical">8dp</item>
        <item name="android:background">@drawable/flora_button_bg</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>
    
    <style name="FloraCategoryUnselected">
        <item name="android:textColor">@color/flora_stem</item>
        <item name="android:textSize">14sp</item>
        <item name="android:paddingHorizontal">16dp</item>
        <item name="android:paddingVertical">8dp</item>
        <item name="android:background">@drawable/flora_edittext_bg</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>
</resources>